From c44e680fb3c28800167126cb0ec6cf273a3dc861 Mon Sep 17 00:00:00 2001
From: Lukas Janik <janik@acrios.com>
Date: Thu, 6 Feb 2025 11:52:51 +0100
Subject: [PATCH 1/3] pn5xx_i2c.c: Fix: replace pr_warning() for pr_warn()

---
 pn5xx_i2c.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/pn5xx_i2c.c b/pn5xx_i2c.c
index 7faa67d..b3571a7 100644
--- a/pn5xx_i2c.c
+++ b/pn5xx_i2c.c
@@ -238,7 +238,7 @@ static ssize_t pn54x_dev_read(struct file *filp, char __user *buf,
 			if (gpio_get_value(pn54x_dev->irq_gpio))
 				break;
 
-			pr_warning("%s: spurious interrupt detected\n", __func__);
+			pr_warn("%s: spurious interrupt detected\n", __func__);
 		}
 	}
 
@@ -261,7 +261,7 @@ static ssize_t pn54x_dev_read(struct file *filp, char __user *buf,
 		return -EIO;
 	}
 	if (copy_to_user(buf, tmp, ret)) {
-		pr_warning("%s : failed to copy to user space\n", __func__);
+		pr_warn("%s : failed to copy to user space\n", __func__);
 		return -EFAULT;
 	}
 	return ret;
-- 
2.48.1

